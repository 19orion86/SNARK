DATABASE_URL=postgres://postgres:postgres@localhost:5432/snark_portal

# Mock включается ТОЛЬКО при точном значении "true".
# Отсутствие переменной / false / TRUE / 1 → реальная БД и auth.
# В production + USE_MOCK_DB=true приложение НЕ стартует.
USE_MOCK_DB=true

# Cookie Secure: true при HTTPS; false для локального HTTP / NSSM без TLS.
# Если не задано — как NODE_ENV===production.
COOKIE_SECURE=false

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

# Dev-учётки для seed (scripts/seed-dev-users.ts) и mock-login.
# Пароли задаёте вы; в git — только плейсхолдеры.
DEV_ADMIN_EMAIL=admin@snark.ru
DEV_ADMIN_PASSWORD=replace-with-local-admin-password
DEV_HR_EMAIL=hr@snark.ru
DEV_HR_PASSWORD=replace-with-local-hr-password
DEV_EMPLOYEE_EMAIL=employee@snark.ru
DEV_EMPLOYEE_PASSWORD=replace-with-local-employee-password

# Python-сервис протоколов (services/protocols)
PROTOCOLS_API_URL=http://localhost:8000

# Shared-secret для POST /api/internal/protocols/action-items/sync
# и обратного PATCH статуса поручения в Python-сервисе.
INTERNAL_TOKEN=replace-with-shared-internal-token

# Опционально: UUID постановщика задач из протоколов (иначе — первый admin).
# PROTOCOL_TASK_CREATOR_USER_ID=

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central-1
S3_BUCKET=snark-portal
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key

# Realtime (опционально). Без REDIS_URL — in-process EventEmitter.
REDIS_URL=redis://localhost:6379

# Публичный URL портала (ссылки в email-уведомлениях)
APP_URL=http://localhost:3000

# SMTP для email-уведомлений (без SMTP_HOST — только in-app)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@snark.ru

# AI CoPilot (опционально). Без ключа — heuristic fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Web Push (PWA). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@snark.ru
